APP_NAME=Secure Enterprise AI API
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/secure_enterprise_ai
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

UPLOAD_DIR=uploaded_documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150